# ==============================================================================
# AI IT Helpdesk — Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit the real .env file to version control.
# ==============================================================================

# Application Environment: local | staging | production
ENVIRONMENT=local
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL / Supabase)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/helpdesk_dev
# Staging/Prod: Supabase connection pooling string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/helpdesk_dev

# JWT Authentication & Cryptography
# Generate a high-entropy secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 / OIDC
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# File Storage Configuration (Supabase Storage)
SUPABASE_URL=replace_with_supabase_project_url
SUPABASE_KEY=replace_with_supabase_service_role_or_anon_key
SUPABASE_STORAGE_BUCKET=attachments

# Email Notification Provider (Split by Environment per SRS §3.9)
# 1. Local Development (Gmail SMTP + App Password)
GMAIL_SMTP_ADDRESS=your_email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_16_character_app_password

# 2. Staging / Production (Brevo HTTP API - port 443 HTTPS)
BREVO_API_KEY=replace_with_brevo_api_key
EMAIL_SENDER_ADDRESS=support@yourdomain.com
EMAIL_SENDER_NAME=AI IT Helpdesk

# Scheduler Configuration (The Sweep)
SWEEP_INTERVAL_MINUTES=5

# Client Configuration (used by Flutter build / dart-define)
API_BASE_URL=http://localhost:8000/api/v1
