    {
      "name": "06 - Multi-Tier Approvals",
      "item": [
        {
          "name": "Request Business Approval",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{operator_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approver_id\": \"{{lead_user_id}}\",\n  \"reason\": \"Requires emergency maintenance authorization for hardware reset\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cases/{{case_id}}/approvals",
              "host": ["{{base_url}}"],
              "path": ["cases", "{{case_id}}", "approvals"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Approval request created and case transitions to awaiting_approval', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.expect(json.decision).to.eql('pending');",
                  "    pm.environment.set('approval_id', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Pending Approvals as Lead",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{lead_token}}" }],
            "url": {
              "raw": "{{base_url}}/approvals/pending",
              "host": ["{{base_url}}"],
              "path": ["approvals", "pending"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns pending approvals list', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.items).to.be.an('array');",
                  "    var found = json.items.some(function(a) { return a.id === pm.environment.get('approval_id'); });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Decide Approval (Approved)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{lead_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"reason\": \"Approved for 30-minute maintenance window\"\n}"
            },
