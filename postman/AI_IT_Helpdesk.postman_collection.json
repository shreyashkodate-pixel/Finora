          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Profile returns authenticated user details', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.email).to.eql('requester_pm@enterprise.com');",
                  "    pm.expect(json.role).to.eql('requester');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
