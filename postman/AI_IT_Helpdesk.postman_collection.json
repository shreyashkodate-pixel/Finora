          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token rotation returns 200 and new credentials', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "    pm.expect(json.refresh_token).to.be.a('string');",
                  "    pm.environment.set('requester_token', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Case Lifecycle & SLA",
      "item": [
        {
          "name": "Create P1 Incident",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{requester_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN Gateway Core Router Outage\",\n  \"description\": \"Global workforce cannot connect via Cisco AnyConnect; high packet loss across all tunnel interfaces.\",\n  \"type\": \"incident\",\n  \"priority\": \"p1\",\n  \"site\": \"Campus North\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cases",
              "host": ["{{base_url}}"],
              "path": ["cases"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Case created with sequential reference number and SLA', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.expect(json.reference_number).to.match(/^INC-\\d{4}-\\d{6}$/);",
                  "    pm.expect(json.status).to.eql('new');",
                  "    pm.expect(json.version).to.eql(1);",
                  "    pm.environment.set('case_id', json.id);",
                  "    pm.environment.set('case_version', json.version);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Cases Filtered by Priority",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operator_token}}" }],
            "url": {
              "raw": "{{base_url}}/cases?priority=p1",
              "host": ["{{base_url}}"],
              "path": ["cases"],
              "query": [{ "key": "priority", "value": "p1" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns P1 cases list', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.items).to.be.an('array');",
                  "    pm.expect(json.items.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Full Case Details with SLA",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "url": {
              "raw": "{{base_url}}/cases/{{case_id}}",
              "host": ["{{base_url}}"],
              "path": ["cases", "{{case_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns case details with 24/7 SLA window', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.environment.get('case_id'));",
                  "    pm.expect(json.sla).to.be.an('object');",
                  "    pm.expect(json.sla.target_response_at).to.be.a('string');",
                  "    pm.expect(json.sla.target_resolve_at).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Transition Case Status (Optimistic Locking)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{operator_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_status\": \"assigned\",\n  \"version\": {{case_version}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/cases/{{case_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["cases", "{{case_id}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status transitioned to assigned and version incremented', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('assigned');",
                  "    pm.expect(json.version).to.eql(pm.environment.get('case_version') + 1);",
                  "    pm.environment.set('case_version', json.version);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Message Stream & Confidentiality",
      "item": [
        {
          "name": "Post Public Message as Requester",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{requester_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Can you confirm if engineering teams are actively investigating?\",\n  \"visibility\": \"requester_visible\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cases/{{case_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["cases", "{{case_id}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Public message posted successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.visibility).to.eql('requester_visible');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Post Internal Note as Operator",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{operator_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"INTERNAL ONLY: Border router bgp peer dropped session. Initiating hardware loopback test.\",\n  \"visibility\": \"internal_only\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cases/{{case_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["cases", "{{case_id}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Internal note posted successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.visibility).to.eql('internal_only');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verify Message Masking for Requester",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "url": {
              "raw": "{{base_url}}/cases/{{case_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["cases", "{{case_id}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Internal notes are completely masked from requester view', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var messages = pm.response.json();",
                  "    pm.expect(messages).to.be.an('array');",
                  "    messages.forEach(function (m) {",
                  "        pm.expect(m.visibility).to.eql('requester_visible');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verify Internal Notes Visible to Operator",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operator_token}}" }],
            "url": {
              "raw": "{{base_url}}/cases/{{case_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["cases", "{{case_id}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Operator can view both internal and public messages', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var messages = pm.response.json();",
                  "    var hasInternal = messages.some(function(m) { return m.visibility === 'internal_only'; });",
                  "    pm.expect(hasInternal).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
